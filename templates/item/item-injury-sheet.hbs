<section class="tab {{tabs.form.id}} {{tabs.form.cssClass}} scrollable" id="form" data-tab="{{tabs.form.id}}"
    data-group="{{tabs.form.group}}">

    <div class="resource-group-styled knack-sheet">

        <div class="form-group">
            <label class="styled-label">{{localize "ARKHAM_HORROR.INJURY_SHEET.Active"}}</label>
            <input type="checkbox" name="system.active" {{#if system.active}}checked{{/if}}>
        </div>

        <hr />

        <div class="form-group">
            <label class="styled-label" for="status-effect">{{localize "ARKHAM_HORROR.StatusEffects.ItemStatus"}}</label>
            <select id="status-effect" name="system.statusEffectId">
                <option value="">{{localize "ARKHAM_HORROR.StatusEffects.None"}}</option>
                {{#each statusEffectChoices as |choice|}}
                <option value="{{choice.id}}" {{#if choice.selected}}selected{{/if}}>{{choice.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="notes">{{localize "ARKHAM_HORROR.StatusEffects.ItemStatusHint"}}</div>

        <hr />

        <h5 class="quick-label">{{localize "ARKHAM_HORROR.INJURY_SHEET.Healing"}}</h5>
        <div class="form-group">
            <label class="styled-label" for="heal-difficulty">{{localize "ARKHAM_HORROR.INJURY_SHEET.HealDifficulty"}}</label>
            <input type="number" id="heal-difficulty" name="system.healDifficulty" value="{{system.healDifficulty}}" min="1" max="3" step="1">
        </div>
        <div class="notes">{{localize "ARKHAM_HORROR.INJURY_SHEET.HealDifficultyHint"}}</div>

        <div class="form-group">
            <label class="styled-label" for="can-heal-naturally">{{localize "ARKHAM_HORROR.INJURY_SHEET.CanHealNaturally"}}</label>
            <input type="checkbox" id="can-heal-naturally" name="system.canHealNaturally" {{#if system.canHealNaturally}}checked{{/if}}>
        </div>
        <div class="notes">{{localize "ARKHAM_HORROR.INJURY_SHEET.CanHealNaturallyHint"}}</div>

        <hr />

        {{> "systems/arkham-horror-rpg-fvtt/templates/item/parts/roll-effects.hbs"
            title=(localize "ARKHAM_HORROR.INJURY_SHEET.RollEffectsAutomatic")}}

    </div>
</section>
